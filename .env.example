GITHUB_TOKEN=github_pat_your_token
GITHUB_WEBHOOK_SECRET=replace_with_random_secret

# Jira Cloud
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
